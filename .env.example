# Landslide Early Warning & Evacuation System - Environment Configuration
# Twilio Fallback Configuration (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=your_twilio_number
TWILIO_WHATSAPP_FROM=whatsapp:your_twilio_whatsapp

# Fast2SMS National Indian Telecom Gateway (Recommended for SIH)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# LoRa Mesh Simulation Frequency (IN865 Band: 865.0 - 867.0 MHz)
LORA_FREQ_MHZ=865.2
LORA_SPREADING_FACTOR=12
